# Copy this file to .env and fill in real values before running the backend.

# Google Gemini API Key (Recommended)
# Get a free key at https://aistudio.google.com/
# Powers the Workspace Chat, Case Summarizer, Prediction Engine, and Document Analyzer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Anthropic Claude Fallback
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Change this to a long random string before running in anything but local dev
JWT_SECRET=dev-secret-change-me

# SQLite by default — swap for a Postgres URL to use a real database, e.g.
# postgresql://user:password@localhost:5432/justimind
DATABASE_URL=sqlite:///./justimind.db

# CourtListener API Token for real case-law search
COURTLISTENER_API_KEY=

